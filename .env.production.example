# =====================================================================
# Variables de PRODUCCION (servidor Linux)
# Copiar a .env en el servidor y completar. NUNCA subir .env a GitHub.
#   cp .env.production.example .env
#   chmod 600 .env
# =====================================================================

# --- PostgreSQL ---
DB_USER=myra
# Usa una clave larga y distinta de "postgres".
# Si contiene $, espacios o #, enciérrala entre comillas simples.
DB_PASSWORD='CAMBIA_ESTA_CLAVE'
DB_NAME=myra

# --- n8n ---
# Si migras las credenciales del PC, usa EXACTAMENTE la misma clave.
# Si empiezas de cero, genera una nueva con: openssl rand -hex 32
N8N_ENCRYPTION_KEY=CAMBIA_ESTA_CLAVE

# URL pública real (HTTPS, con barra final). Telegram la necesita.
WEBHOOK_URL=https://myra.ucn.cl/

# --- Red ---
# Con Nginx/Caddy en el mismo host, n8n solo escucha en localhost.
N8N_BIND=127.0.0.1
PG_BIND=127.0.0.1

# Saltos de proxy: 1 con Nginx/Caddy en el host.
# Si además hay Cloudflare u otro proxy delante, usa 2.
N8N_PROXY_HOPS=1
