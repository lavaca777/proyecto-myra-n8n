    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst chatId = input.telegram_chat_id;\nconst nombreTelegram = input.nombre_usuario || input.nombre_telegram || 'usuario';\nconst rawTexto = (input.texto || '').trim();\n\n// Extraer código si viene directo ('MYRA-2026') o vía Deep Link ('/start MYRA-2026')\nconst match = rawTexto.match(/^(?:\\/start\\s+)?(MYRA-[A-Z0-9]{4,8})$/i);\n\nreturn [{\n  json: {\n    telegram_chat_id: chatId,\n    nombre_telegram: nombreTelegram,\n    texto_original: rawTexto,\n    tiene_formato_codigo: Boolean(match),\n    codigo_limpio: match ? match[1].toUpperCase() : null\n  }\n}];"
      },
      "id": "9a478318-d802-4813-a7b1-4c2419ab3c1a",
      "name": "Extraer y validar formato",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -928,
        224
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "cond-formato-ok",
              "leftValue": "={{ $json.tiene_formato_codigo }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "298a65ff-cc2b-49c0-8ad6-57be4120088a",
      "name": "Tiene formato de codigo",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -704,
        224
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $json.telegram_chat_id }}",
        "text": "=👋 Hola *{{ $json.nombre_telegram }}*.\n\nTu cuenta aún no está vinculada a *MYRA*.\nPor favor, envíame el código de invitación que te entregó tu administrador (ejemplo: `MYRA-2026`).",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "5bba2712-0890-44ba-a94b-7c42c5600e61",
      "name": "Pedir codigo de invitacion",
