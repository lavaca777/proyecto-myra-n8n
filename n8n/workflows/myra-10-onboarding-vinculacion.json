    {
      "parameters": {
        "jsCode": "const user = $input.first().json;\nconst chatId = $('Extraer y validar formato').first().json.telegram_chat_id;\n\nconst mensajesPorRol = {\n  jefe_obra: `✅ *¡Vinculación exitosa, ${user.nombre}!*\\n\\nTu perfil ha sido activado como *Jefe de Obra*.\\nYa puedes enviarme notas de voz con tus avances diarios o fotos de boletas para registrar gastos.`,\n  administrador: `✅ *¡Vinculación exitosa, ${user.nombre}!*\\n\\nTu perfil ha sido activado como *Administrador*.\\nTienes acceso completo a gestión de obras, reportes y administración del sistema.`,\n  gerencia: `✅ *¡Vinculación exitosa, ${user.nombre}!*\\n\\nTu perfil ha sido activado como *Gerencia*.\\nPuedes consultar el estado de avance y costos de las obras en cualquier momento.`\n};\n\nconst mensajeFinal = mensajesPorRol[user.rol] || `✅ *¡Vinculación exitosa, ${user.nombre}!*\\n\\nTu cuenta ya está activa en MYRA con el rol: *${user.rol}*.`;\n\nreturn [{\n  json: {\n    telegram_chat_id: chatId,\n    mensaje: mensajeFinal\n  }\n}];"
      },
