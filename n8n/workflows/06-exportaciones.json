    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r && r.id);\nconst fecha = (f) => {\n  const s = String(f || '').slice(0, 10);\n  return s ? s.split('-').reverse().join('-') : '';\n};\nreturn rows.map(r => ({\n  json: {\n    'ID': r.id,\n    'Fecha': fecha(r.fecha_gasto),\n    'Cliente': r.cliente || '',\n    'Proyecto': r.proyecto || '',\n    'Categoría': r.categoria || '',\n    'Proveedor': r.proveedor || '',\n    'Descripción': r.descripcion || '',\n    'Medio de pago': r.medio_pago || '',\n    'Monto': Number(r.monto_total) || 0,\n    'Registrado por': r.registrado_por || '',\n    'Origen': r.origen || ''\n  }\n}));"
      },
