    {
      "parameters": {
        "jsCode": "const base = $('Cuando se ejecuta').first().json;\nconst cb = String(base.callback_data || '').split(':');\nconst formato = cb[2] === 'csv' ? 'csv' : 'xlsx';\nconst rango = cb[3] === 'all' ? 'all' : '30d';\nconst proyecto = cb[4] || 'all';\nreturn [{ json: { ...base, formato, rango, proyecto } }];"
      },
      "id": "e06c0a2e-0000-4000-8000-00000000000a",
      "name": "Preparar filtros",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        240
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT g.id,\n       g.fecha_gasto,\n       c.nombre AS cliente,\n       p.nombre AS proyecto,\n       cat.nombre AS categoria,\n       pr.nombre AS proveedor,\n       g.descripcion,\n       mp.nombre AS medio_pago,\n       g.monto_total,\n       u.nombre AS registrado_por,\n       g.origen,\n       g.registrado_en\nFROM gastos g\nJOIN proyectos p ON p.id = g.proyecto_id\nJOIN clientes c ON c.id = p.cliente_id\nJOIN usuarios u ON u.id = g.usuario_id\nLEFT JOIN categorias cat ON cat.id = g.categoria_id\nLEFT JOIN proveedores pr ON pr.id = g.proveedor_id\nLEFT JOIN medios_pago mp ON mp.id = g.medio_pago_id\nWHERE g.estado = 'confirmado'\n  AND ($1::text = 'all' OR g.proyecto_id::text = $1::text)\n  AND ($2::text = 'all' OR g.fecha_gasto >= current_date - interval '30 days')\nORDER BY g.fecha_gasto DESC, g.id DESC;",
        "options": {
          "queryReplacement": "={{ [ $json.proyecto, $json.rango ] }}"
        }
      },
