    {
      "parameters": {
        "jsCode": "const base = $('Cuando se ejecuta').first().json;\nconst cb = String(base.callback_data || '').split(':');\nconst formato = cb[2] === 'csv' ? 'csv' : 'xlsx';\nconst rango = cb[3] === 'all' ? 'all' : '30d';\nconst proyectos = $input.all().map(i => i.json).filter(p => p && p.id);\n\nconst rows = [{\n  row: { buttons: [{ text: '🏢 Todos los proyectos', additionalFields: { callback_data: `exp:run:${formato}:${rango}:all` } }] }\n}];\nfor (let i = 0; i < proyectos.length; i += 2) {\n  const buttons = proyectos.slice(i, i + 2).map(p => ({\n    text: `🏗️ ${p.nombre}`,\n    additionalFields: { callback_data: `exp:run:${formato}:${rango}:${p.id}` }\n  }));\n  rows.push({ row: { buttons } });\n}\nrows.push({ row: { buttons: [{ text: '⬅️ Volver', additionalFields: { callback_data: `exp:fmt:${formato}` } }] } });\n\nreturn [{\n  json: {\n    texto: '🏢 <b>Proyecto</b>\\n\\n¿Quieres exportar todos los proyectos o uno en particular?',\n    inlineKeyboard: { rows },\n    telegram_chat_id: base.telegram_chat_id\n  }\n}];"
      },
