    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH nuevo_cliente AS (\n  INSERT INTO clientes (nombre)\n  SELECT $1::text\n  WHERE $1::text IS NOT NULL\n    AND NOT EXISTS (\n      SELECT 1 FROM clientes\n      WHERE unaccent(lower(nombre)) = unaccent(lower($1::text))\n    )\n  ON CONFLICT (nombre) DO NOTHING\n  RETURNING id\n),\ncliente AS (\n  SELECT COALESCE(\n    (SELECT id FROM nuevo_cliente),\n    (SELECT id FROM clientes WHERE unaccent(lower(nombre)) = unaccent(lower($1::text)) LIMIT 1)\n  ) AS id\n),\nproyecto AS (\n  INSERT INTO proyectos (cliente_id, nombre)\n  SELECT cliente.id, $2::text\n  FROM cliente\n  WHERE cliente.id IS NOT NULL\n  ON CONFLICT (nombre) DO NOTHING\n  RETURNING id\n),\naliases AS (\n  INSERT INTO proyecto_alias (proyecto_id, alias)\n  SELECT proyecto.id, a.alias\n  FROM proyecto, jsonb_array_elements_text($3::jsonb) AS a(alias)\n  ON CONFLICT DO NOTHING\n  RETURNING id\n)\nSELECT proyecto.id FROM proyecto;",
        "options": {
          "queryReplacement": "={{ [ $('Buscar pendiente').first().json.payload.cliente_nombre || null, $('Buscar pendiente').first().json.payload.nombre || null, JSON.stringify($('Buscar pendiente').first().json.payload.alias || []) ] }}"
        }
      },
