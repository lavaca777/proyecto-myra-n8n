    {
      "parameters": {
        "jsCode": "const p = $input.first().json.payload || {};\nconst base = $('Cuando se ejecuta').first().json;\nconst esc = (s) => String(s ?? '')\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;');\nconst nombre = esc(p.nombre || '(sin nombre)');\nconst cliente = esc(p.cliente_nombre || '(sin cliente)');\nconst alias = Array.isArray(p.alias) ? p.alias : [];\nconst texto = `🏗️ <b>Nuevo proyecto</b>\\n\\n<b>Nombre:</b> ${nombre}\\n<b>Cliente:</b> ${cliente}\\n<b>Alias:</b> ${alias.length ? alias.map(esc).join(', ') : '(ninguno)'}\\n\\n¿Confirmas la creación?`;\nreturn [{ json: { respuesta: texto, telegram_chat_id: base.telegram_chat_id } }];"
      },
