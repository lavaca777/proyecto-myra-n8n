    {
      "parameters": {
        "jsCode": "const base = $('Cuando se ejecuta').first().json;\nconst cb = String(base.callback_data || '');\nlet accion = 'menu';\nif (cb === 'adm:new') accion = 'new';\nelse if (cb === 'adm:cancel') accion = 'cancel';\nelse if (cb === 'adm:save') accion = 'save';\nelse if (cb === 'adm:fix') accion = 'fix_menu';\nelse if (cb === 'adm:fix:nombre') accion = 'fix_nombre';\nelse if (cb === 'adm:fix:cliente') accion = 'fix_cliente';\nelse if (cb === 'adm:fix:alias') accion = 'fix_alias';\nelse if (cb === 'adm:fix:back') accion = 'fix_back';\nreturn [{ json: { ...base, accion } }];"
      },
