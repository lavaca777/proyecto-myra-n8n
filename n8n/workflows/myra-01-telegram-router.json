        "query": "SELECT p.id, p.usuario_id, p.accion, p.paso, p.entidad_id, p.payload\nFROM admin_pending p\nJOIN usuarios u ON u.id = p.usuario_id\nWHERE p.usuario_id = $1\n  AND p.accion = 'modo'\n  AND p.actualizado_en > now() - interval '2 hours'\n  AND u.rol IN ('administrador','gerencia')\nLIMIT 1;",
