    {
      "parameters": {
        "jsCode": "const update = $json;\nconst msg = update.message;\nconst cb = update.callback_query;\nconst from = (msg && msg.from) || (cb && cb.from) || {};\nconst chat = (msg && msg.chat) || (cb && cb.message && cb.message.chat) || {};\nconst texto = (msg && msg.text) || '';\nconst esComandoTexto = texto.startsWith('/');\n\nlet tipo = 'texto';\nif (cb) tipo = 'callback';\nelse if (msg && msg.voice) tipo = 'voz';\nelse if (msg && msg.photo) tipo = 'foto';\nelse if (esComandoTexto) tipo = 'comando';\n\nlet comando = null;\nif (cb && cb.data && String(cb.data).startsWith('cmd:')) {\n  tipo = 'comando';\n  comando = String(cb.data).slice(4).split('@')[0].toLowerCase();\n} else if (cb && cb.data && String(cb.data).startsWith('exp:')) {\n  tipo = 'comando';\n  comando = 'exportar';\n} else if (cb && cb.data && String(cb.data).startsWith('adm:')) {\n  tipo = 'comando';\n  comando = 'maestras';\n} else if (esComandoTexto) {\n  comando = texto.split(/\\s+/)[0].replace('/', '').split('@')[0].toLowerCase();\n}\n\nconst alias = {\n  help: 'ayuda', h: 'ayuda', ayuda: 'ayuda',\n  start: 'start', inicio: 'start', menu: 'start',\n  proyectos: 'proyectos', resumen: 'resumen',\n  ultimos: 'ultimos', cancelar: 'cancelar',\n  gastos: 'exportar'\n};\nif (comando) comando = alias[comando] || comando;\n\nreturn [{\n  json: {\n    tipo,\n    telegram_chat_id: chat.id,\n    telegram_user_id: from.id,\n    telegram_message_id: (msg && msg.message_id) || (cb && cb.message && cb.message.message_id) || null,\n    texto,\n    comando,\n    callback_data: (cb && cb.data) || null,\n    file_id: (msg && msg.voice && msg.voice.file_id) || null,\n    duracion_seg: (msg && msg.voice && msg.voice.duration) || null,\n    nombre_usuario: [from.first_name, from.last_name].filter(Boolean).join(' '),\n    update_id: update.update_id\n  }\n}];"
      },
      "id": "2f9ec607-1cd7-4002-a8b3-07eed058dc67",
      "name": "Normalizar update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        304,
