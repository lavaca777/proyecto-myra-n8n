 AS proyecto,\n       cat.nombre AS categoria,\n       pr.nombre AS proveedor,\n       g.descripcion,\n       mp.nombre AS medio_pago,\n       g.monto_total,\n       u.nombre AS registrado_por,\n       g.origen,\n       g.registrado_en\nFROM gastos g\nJOIN proyectos p ON p.id = g.proyecto_id\nJOIN clientes c ON c.id = p.cliente_id\nJOIN usuarios u ON u.id = g.usuario_id\nLEFT JOIN categorias cat ON cat.id = g.categoria_id\nLEFT JOIN proveedores pr ON pr.id = g.proveedor_id\nLEFT JOIN medios_pago mp ON mp.id = g.medio_pago_id\nWHERE g.estado = 'confirmado'\n  AND ($1::text = 'all' OR g.proyecto_id::text = $1::text)\n  AND ($2::text = 'all' OR g.fecha_gasto >= (now() AT TIME ZONE 'America/Santiago')::date - 30)\nORDER BY g.fecha_gasto DESC, g.id DESC;","options":{"queryReplacement":"={{ [ $json.proyecto, $json.rango ] }}"}},"id":"e06c0a2e-0000-4000-8000-00000000000b","name":"Gastos","type":"n8n-nodes-base.postgres","typeVersion":2.7,"executeOnce":true,"alwaysOutputData":true,"position":[896,336],"credentials":{"postgres":{"id":"ufn1vDeGKOcqMtep","name":"Postgres account"}}},{"parameters":{"mode":"expression","numberOutputs":2,"output":"={{ $json.id ? 0 : 1 }}"},"id":"e06c0a2e-0000-4000-8000-00000000000c","name":"¿Hay datos?","type":"n8n-nodes-base.switch","typeVersion":3.4,"position":[1120,336]},{"parameters":{"chatId":"={{ $('Cuando se ejecuta').first().json.telegram_chat_id }}","text":"📭 <b>Sin gastos</b>\n\nNo hay gastos confirmados para esos filtros.","replyMarkup":"inlineKeyboard","inlineKeyboard":{"rows":[{"row":{"buttons":[{"text":"🔁 Elegir otro rango","additionalFields":{"callback_data":"exp:start"}}]}}]},"additionalFields":{"appendAttribution":false,"parse_mode":"HTML"}},"id":"e06c0a2e-0000-4000-8000-00000000000d","name":"Responder sin datos","type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[1344,448],"webhookId":"e06c0a2e-0000-4000-8000-0000000000f0","credentials":{"telegramApi":{"id":"YPgCfnQDmZ3qwb8E","name":"Telegram account"}}},{"parameters":{"jsCode":"const rows = $input.all().map(i => i.json).filter(r => r && r.id);\nconst fecha = (f) => {\n  const s = String(f || '').slice(0, 10);\n  return s ? s.split('-').reverse().join('-') : '';\n};\nreturn rows.map(r => ({\n  json: {\n    'ID': r.id,\n    'Fecha': fecha(r.fecha_gasto),\n    'Cliente': r.cliente || '',\n    'Proyecto': r.proyecto || '',\n    'Categoría': r.categoria || '',\n    'Proveedor': r.proveedor || '',\n    'Descripción': r.descripcion || '',\n    'Medio de pago': r.medio_pago || '',\n    'Monto': Number(r.monto_total) || 0,\n    'Registrado por': r.registrado_por || '',\n    'Origen': r.origen || ''\n  }\n}));"},"id":"e06c0a2e-0000-4000-8000-00000000000e","name":"Preparar filas","type":"n8n-nodes-base.code","typeVersion":2,"position":[1344,256]},{"parameters":{"mode":"expression","numberOutputs":2,"output":"={{ $('Preparar filtros').first().json.formato === 'csv' ? 1 : 0 }}"},"id":"e06c0a2e-0000-4000-8000-00000000000f","name":"Formato","type":"n8n-nodes-base.switch","typeVersion":3.4,"position":[1568,256]},{"parameters":{"operation":"toFile","fileFormat":"xlsx","options":{"fileName":"={{ 'gastos_' + $now.toFormat('yyyyMMdd_HHmm') + '.xlsx' }}","headerRow":true,"sheetName":"Gastos"}},"id":"e06c0a2e-0000-4000-8000-000000000010","name":"Crear Excel","type":"n8n-nodes-base.spreadsheetFile","typeVersion":2,"position":[1792,160]},{"parameters":{"operation":"toFile","fileFormat":"csv","options":{"fileName":"={{ 'gastos_' + $now.toFormat('yyyyMMdd_HHmm') + '.csv' }}","headerRow":true}},"id":"e06c0a2e-0000-4000-8000-000000000011","name":"Crear CSV","type":"n8n-nodes-base.spreadsheetFile","typeVersion":2,"position":[1792,352]},{"parameters":{"operation":"sendDocument","chatId":"={{ $('Cuando se ejecuta').first().json.telegram_chat_id }}","binaryData":true,"additionalFields":{"caption":"={{ 'Gastos exportados · ' + $('Preparar filtros').first().json.formato + ' · ' + $('Preparar filtros').first().json.rango }}"}},"id":"e06c0a2e-0000-4000-8000-00000