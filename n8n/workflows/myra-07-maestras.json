    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  COALESCE((\n    SELECT json_agg(x ORDER BY x.nombre)\n    FROM (\n      SELECT p.id,\n             p.nombre,\n             p.activo,\n             p.cliente_id,\n             c.nombre AS cliente,\n             COALESCE(\n               json_agg(pa.alias ORDER BY pa.alias) FILTER (WHERE pa.alias IS NOT NULL),\n               '[]'::json\n             ) AS alias\n      FROM proyectos p\n      JOIN clientes c ON c.id = p.cliente_id\n      LEFT JOIN proyecto_alias pa ON pa.proyecto_id = p.id\n      GROUP BY p.id, p.nombre, p.activo, p.cliente_id, c.nombre\n    ) x\n  ), '[]'::json) AS proyectos,\n  COALESCE((\n    SELECT json_agg(json_build_object('id', c.id, 'nombre', c.nombre) ORDER BY c.nombre)\n    FROM clientes c\n    WHERE c.activo\n  ), '[]'::json) AS clientes,\n  (SELECT to_json(a)\n   FROM admin_pending a\n   WHERE a.usuario_id = $1\n     AND a.accion = 'modo'\n     AND a.actualizado_en > now() - interval '2 hours'\n   LIMIT 1) AS pendiente;",
        "options": {
          "queryReplacement": "={{ [ $json.usuario_id ] }}"
        }
      },
      "id": "60ffa512-1a46-4594-960a-b403ba846233",
      "name": "Cargar contexto",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        768,
        2064
      ],
      "executeOnce": true,
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "DddndwjEnI7KMH9I",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const base = $('Cuando se ejecuta').first().json;\nconst ctx = $input.first().json || {};\nconst pendiente = ctx.pendiente || null;\nlet payload = {};\nif (pendiente && pendiente.payload) {\n  payload = typeof pendiente.payload === 'string' ? JSON.parse(pendiente.payload) : pendiente.payload;\n}\nif (pendiente && pendiente.paso) payload.paso = pendiente.paso;\nconst catalogo = {\n  proyectos: Array.isArray(ctx.proyectos) ? ctx.proyectos : [],\n  clientes: Array.isArray(ctx.clientes) ? ctx.clientes : []\n};\nconst cb = String(base.callback_data || '');\nconst texto = String(base.texto || '').trim();\nconst norm = String(texto).normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase().trim();\nconst modoActivo = !!(pendiente && pendiente.accion === 'modo');\nconst paso = String(payload.paso || '');\nlet accion = 'menu';\nif (cb === 'cmd:maestras' || /^\\/maestras\\b/i.test(texto)) accion = 'abrir';\nelse if (cb === 'adm:exit') accion = 'salir';\nelse if (cb === 'adm:list') accion = 'listar';\nelse if (cb === 'adm:menu') accion = 'menu';\nelse if (cb === 'adm:save') accion = 'guardar';\nelse if (cb === 'adm:fix') accion = 'corregir';\nelse if (cb === 'adm:cancel') accion = 'cancelar';\nelse if (cb === 'adm:cliente:usar') accion = 'cliente_usar';\nelse if (cb === 'adm:cliente:nuevo') accion = 'cliente_nuevo';\nelse if (modoActivo && texto) {\n  if (/^(salir|terminar|cerrar|chao|adios|adiós)$/i.test(norm)) accion = 'salir';\n  else if (/^(cancelar|anular)$/i.test(norm)) accion = 'cancelar';\n  else if (/^(listar|lista|proyectos|ver proyectos|muestra(me)?( los)? proyectos|que proyectos)\\b/i.test(norm)) accion = 'listar';\n  else if (/^(ayuda|help|\\?)$/i.test(norm)) accion = 'menu';\n  else if (paso === 'confirmar' && /^(si|sí|confirmar|confirmo|correcto|ok|dale|adelante|guardar|registrar)\\b/i.test(norm)) accion = 'guardar';\n  else if (paso === 'confirmar' && /^(no|corregir|editar|cambiar|mal|error)\\b/i.test(norm)) accion = 'corregir';\n  else if (paso === 'cliente_ambiguo' && /^(usar|usa|existente|el existente|si|sí)\\b/i.test(norm)) accion = 'cliente_usar';\n  else if (paso === 'cliente_ambiguo' && /^(crear|crea|nuevo|nueva|no)\\b/i.test(norm)) accion = 'cliente_nuevo';\n  else if (['falta_nombre','falta_cliente','falta_proyecto','cliente_ambiguo'].includes(paso)) accion = 'completar';\n  else accion = 'interpretar';\n} else if (modoActivo) accion = 'menu';\nelse accion = 'menu_sin_modo';\nreturn [{ json: { ...base, contexto: ctx, catalogo, pendiente, payload, texto, callback_data: cb, accion, paso } }];"
      },
      "id": "f07ba98e-7500-4f79-a16f-9c10101f2cce",
      "name": "Preparar entrada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        992,
