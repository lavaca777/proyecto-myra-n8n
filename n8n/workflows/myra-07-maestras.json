    {
      "parameters": {
        "jsCode": "const base = $('Preparar entrada').first().json;\nconst proyectos = (base.catalogo && base.catalogo.proyectos) ? base.catalogo.proyectos : [];\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst lineas = proyectos.map(p => {\n  const estado = p.activo ? '✅' : '⛔';\n  const alias = (p.alias || []).length ? `\\n   <i>Alias: ${p.alias.map(esc).join(', ')}</i>` : '';\n  return `${estado} <b>${esc(p.nombre)}</b> — ${esc(p.cliente)}${alias}`;\n});\nconst maxCharsLista = 3200;\nlet usadosLista = 0;\nconst lineasVisibles = [];\nfor (const linea of lineas) {\n  if (usadosLista + linea.length + 1 > maxCharsLista) break;\n  lineasVisibles.push(linea);\n  usadosLista += linea.length + 1;\n}\nconst notaLista = lineasVisibles.length < lineas.length\n  ? `\\n\\n… y ${lineas.length - lineasVisibles.length} proyecto(s) más.`\n  : '';\nconst respuesta = `📁 <b>Proyectos (${proyectos.length})</b>\\n\\n${lineasVisibles.length ? lineasVisibles.join('\\n') + notaLista : '• (no hay proyectos)'}`;\nreturn [{ json: { respuesta, telegram_chat_id: base.telegram_chat_id } }];"
      },
