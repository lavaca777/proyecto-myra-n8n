4a2147c4","name":"Transcribir con Groq","type":"n8n-nodes-base.httpRequest","typeVersion":4.1,"position":[672,-16],"retryOnFail":true,"waitBetweenTries":1000,"credentials":{"groqApi":{"id":"a4tunCFYVMRmrBSB","name":"Groq account"}},"onError":"continueRegularOutput"},{"parameters":{"jsCode":"const response = $input.first().json;\nconst base = $('When Executed by Another Workflow').first().json;\nconst texto = (response.text || '').trim();\nconst segmentos = Array.isArray(response.segments) ? response.segments : [];\nconst noSpeech = segmentos.length\n  ? Math.max(...segmentos.map(s => Number(s.no_speech_prob ?? 0)))\n  : 0;\nconst logprob = segmentos.length\n  ? Math.min(...segmentos.map(s => Number(s.avg_logprob ?? 0)))\n  : 0;\nconst transcripcionOk = texto.length > 0 && noSpeech < 0.5 && logprob > -0.8;\n\nreturn [{\n  json: {\n    ...base,\n    texto_transcrito: transcripcionOk ? texto : '',\n    texto_stt_original: texto,\n    transcripcion_ok: transcripcionOk,\n    stt_no_speech_prob: noSpeech,\n    stt_avg_logprob: logprob\n  }\n}];"},"id":"3f07792e-a449-4984-8d73-3c1dcdcca30e","name":"Extraer transcripcion","type":"n8n-nodes-base.code","typeVersion":2,"position":[896,-16]},{"parameters":{"mode":"expression","numberOutputs":2,"output":"={{ $json.transcripcion_ok ? 0 : 1 }}"},"id":"b6f6b1a2-3c1e-4f7a-9d2b-5e8c1a4f7b90","name":"Transcripcion OK?","type":"n8n-nodes-base.switch","typeVersion":3.4,"position":[1120,-16]},{"parameters":{"jsCode":"return $input.all();"},"id":"c7a7c2b3-4d2f-4a8b-8e3c-6f9d2b5a8c01","name":"Devolver transcripcion","type":"n8n-nodes-base.code","typeVersion":2,"position":[1344,-112]},{"parameters":{"chatId":"={{ $json.telegram_chat_id }}","text":"No pude escuchar bien el audio. Intenta de nuevo o escribe el gasto.","additionalFields":{"appendAttribution":false}},"id":"d8b8d3c4-5e3a-4b9c-9f4d-7a0e3c6b9d12","name":"Responder error audio","type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[1344,80],"webhookId":"f0daf5e6-7a5c-4dbe-b