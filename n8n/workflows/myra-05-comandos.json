    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT p.id,\n       p.nombre,\n       COALESCE(\n         json_agg(pa.alias ORDER BY pa.alias) FILTER (WHERE pa.alias IS NOT NULL),\n         '[]'::json\n       ) AS alias\nFROM proyectos p\nLEFT JOIN proyecto_alias pa ON pa.proyecto_id = p.id\nWHERE p.activo\nGROUP BY p.id, p.nombre\nORDER BY p.nombre;",
        "options": {}
      },
      "id": "efd2a3cd-e9b8-49b7-99ab-ce9f5c2a2364",
      "name": "Proyectos",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "executeOnce": true,
      "alwaysOutputData": true,
      "position": [
        -624,
        -192
      ],
      "credentials": {
        "postgres": {
          "id": "DddndwjEnI7KMH9I",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT proyecto,\n       COUNT(*)::int AS compras,\n       SUM(monto_total)::bigint AS total\nFROM v_gastos_detalle\nWHERE fecha_gasto >= date_trunc('month', (now() AT TIME ZONE 'America/Santiago'))::date\nGROUP BY proyecto\nORDER BY total DESC;",
        "options": {}
      },
      "id": "05cef49d-c571-4570-b100-4c61abaccf1c",
      "name": "Resumen",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "executeOnce": true,
      "alwaysOutputData": true,
      "position": [
        -624,
        -32
      ],
      "credentials": {
        "postgres": {
          "id": "DddndwjEnI7KMH9I",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT g.fecha_gasto,\n       p.nombre AS proyecto,\n       pr.nombre AS proveedor,\n       g.monto_total,\n       mp.nombre AS medio_pago,\n       u.nombre AS registrado_por\nFROM gastos g\nJOIN proyectos p ON p.id = g.proyecto_id\nJOIN usuarios u ON u.id = g.usuario_id\nLEFT JOIN proveedores pr ON pr.id = g.proveedor_id\nLEFT JOIN medios_pago mp ON mp.id = g.medio_pago_id\nWHERE (g.usuario_id = $1 OR $2::boolean)\n  AND g.estado = 'confirmado'\nORDER BY g.registrado_en DESC\nLIMIT 5;",
        "options": {
          "queryReplacement": "={{ [ $json.usuario.id, ['administrador','gerencia'].includes(String(($json.usuario && $json.usuario.rol) || $json.usuario_rol || '').toLowerCase()) ] }}"
        }
      },
      "id": "4f24bd82-844e-4438-9e94-7bbec7a17409",
      "name": "Ultimos",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "executeOnce": true,
      "alwaysOutputData": true,
      "position": [
        -624,
        128
      ],
      "credentials": {
        "postgres": {
          "id": "DddndwjEnI7KMH9I",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH cancelados AS (\n  UPDATE registros_entrada\n  SET estado = 'cancelado', campo_pendiente = NULL\n  WHERE usuario_id = $1\n    AND estado IN ('falta_dato', 'pendiente_confirmacion')\n  RETURNING id\n)\nSELECT count(*)::int AS cancelados FROM cancelados;",
        "options": {
          "queryReplacement": "={{ [ $json.usuario.id ] }}"
        }
      },
      "id": "8e1017ab-043f-4ee2-adb3-8cd0b86f78ee",
      "name": "Cancelar",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "executeOnce": true,
      "alwaysOutputData": true,
      "position": [
        -624,
        288
      ],
