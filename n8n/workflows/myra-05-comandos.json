{"updatedAt":"2026-11-12T03:04:16.000Z","createdAt":"2026-11-11T23:52:54.468Z","id":"f05c0a2e-7b3d-4c8a-9e1f-2a3b4c5d6e7f","name":"[MYRA] 05 · Comandos","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"inputSource":"passthrough"},"id":"11111111-1111-4111-8111-111111111111","name":"Cuando se ejecuta","type":"n8n-nodes-base.executeWorkflowTrigger","typeVersion":1.2,"position":[0,0]},{"parameters":{"mode":"expression","numberOutputs":8,"output":"={{ $json.comando === 'start' ? 0 : $json.comando === 'proyectos' ? 1 : $json.comando === 'resumen' ? 2 : $json.comando === 'ultimos' ? 3 : $json.comando === 'cancelar' ? 4 : $json.comando === 'exportar' ? 5 : $json.comando === 'maestras' ? 6 : 7 }}"},"id":"22222222-2222-4222-8222-222222222222","name":"Comando","type":"n8n-nodes-base.switch","typeVersion":3.4,"position":[224,0]},{"parameters":{"operation":"executeQuery","query":"SELECT p.id,\n       p.nombre,\n       COALESCE(\n         json_agg(pa.alias ORDER BY pa.alias) FILTER (WHERE pa.alias IS NOT NULL),\n         '[]'::json\n       ) AS alias\nFROM proyectos p\nLEFT JOIN proyecto_alias pa ON pa.proyecto_id = p.id\nWHERE p.activo\nGROUP BY p.id, p.nombre\nORDER BY p.nombre;","options":{}},"id":"33333333-3333-4333-8333-333333333333","name":"Proyectos","type":"n8n-nodes-base.postgres","typeVersion":2.7,"executeOnce":true,"alwaysOutputData":true,"position":[448,-192],"credentials":{"postgres":{"id":"ufn1vDeGKOcqMtep","name":"Postgres account"}}},{"parameters":{"operation":"executeQuery","query":"SELECT proyecto,\n       COUNT(*)::int AS compras,\n       SUM(monto_total)::bigint AS total\nFROM v_gastos_detalle\nWHERE fecha_gasto >= date_trunc('month', current_date)\nGROUP BY proyecto\nORDER BY total DESC;","options":{}},"id":"44444444-4444-4444-8444-444444444444","name":"Resumen","type":"n8n-nodes-base.postgres","typeVersion":2.7,"executeOnce":true,"alwaysOutputData":true,"position":[448,-32],"credentials":{"postgres":{"id":"ufn1vDeGKOcqMtep","name":"Postgres account"}}},{"parameters":{"operation":"executeQuery","query":"SELECT g.fecha_gasto,\n       p.nombre AS proyecto,\n       pr.nombre AS proveedor,\n       g.monto_total,\n       mp.nombre AS medio_pago,\n       u.nombre AS registrado_por\nFROM gastos g\nJOIN proyectos p ON p.id = g.proyecto_id\nJOIN usuarios u ON u.id = g.usuario_id\nLEFT JOIN proveedores pr ON pr.id = g.proveedor_id\nLEFT JOIN medios_pago mp ON mp.id = g.medio_pago_id\nWHERE (g.usuario_id = $1 OR $2::boolean)\nORDER BY g.registrado_en DESC\nLIMIT 5;","options":{"queryReplacement":"={{ [ $json.usuario.id, ['administrador','gerencia'].includes(String(($json.usuario && $json.usuario.rol) || $json.usuario_rol || '').toLowerCase()) ] }}"}},"id":"55555555-5555-4555-8555-555555555555","name":"Ultimos","type":"n8n-nodes-base.postgres","typeVersion":2.7,"executeOnce":true,"alwaysOutputData":true,"position":[448,128],"credentials":{"postgres":{"id":"ufn1vDeGKOcqMtep","name":"Postgres account"}}},{"parameters":{"operation":"executeQuery","query":"WITH cancelados AS (\n  UPDATE registros_entrada\n  SET estado = 'cancelado', campo_pendiente = NULL\n  WHERE usuario_id = $1\n    AND estado IN ('falta_dato', 'pendiente_confirmacion')\n  RETURNING id\n)\nSELECT count(*)::int AS cancelados FROM cancelados;","options":{"queryReplacement":"={{ [ $json.usuario.id ] }}"}},"id":"66666666-6666-4666-8666-666666666666","name":"Cancelar","type":"n8n-nodes-base.postgres","typeVersion":2.7,"executeOnce":true,"alwaysOutputData":true,"position":[448,288],"credentials":{"postgres":{"id":"ufn1vDeGKOcqMtep","name":"Postgres account"}}},{"parameters":{"jsCode":"const base = $('Cuando se ejecuta').first().json;\nconst comando = String(base.comando || '').toLowerCase();\nconst nombre = base.usuario_nombre || (base.usuario && base.usuario.nombre) || 'equipo';\nconst rol = base.usuario_rol || (base.usuario && base.usuario.rol) || '';\nconst esAdmin = ['administrador', 'gerencia'].includes(String(rol).toLowerCase());\nconst rows = $input.all().map(i => i.json).filter(r => r && Object.keys(r).length > 0);\n\nconst esc = (s) => String(s ?? '')\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;');\n\nconst money = (n) => new Intl.NumberFormat('es-CL', {\n  style: 'currency',\n  currency: 'CLP',\n  maximumFractionDigits: 0\n}).format(Number(n) || 0);\n\nconst fecha = (f) => {\n  const s = String(f || '').slice(0, 10);\n  return s ? s.split('-').reverse().join('-') : '(sin fecha)';\n};\n\nconst proyectos = rows.filter(r => r.nombre).map(r => {\n  const alias = Array.isArray(r.alias) ? r.alias : [];\n  const linea = `• <b>${esc(r.nombre)}</b>`;\n  return alias.length\n    ? `${linea}\\n  <i>Alias: ${alias.map(esc).join(', ')}</i>`\n    : linea;\n});\n\nlet respuesta;\nif (comando === 'start') {\n  respuesta = `🏗️ <b>MYRA · Asistente de gastos</b>\\n\\n¡Hola, <b>${esc(nombre)}</b>! Puedo registrar tus compras por voz o texto.\\n\\n<b>Ejemplo</b>\\n<i>“Anota 12.500 en Copec, débito, obra Peñuelas, bencina.”</i>\\n\\n<b>Proyectos disponibles</b>\\n${proyectos.length ? proyectos.join('\\n') : '• (no hay proyectos cargados)'}\\n\\nUsa los botones de abajo o escribe /ayuda.`;\n} else if (comando === 'proyectos') {\n  respuesta = `📁 <b>Proyectos activos</b>\\n\\n${proyectos.length ? proyectos.join('\\n') : '• (no hay proyectos cargados)'}`;\n} else if (comando === 'resumen') {\n  const filas = rows.filter(r => r.proyecto);\n  if (!filas.length) {\n    respuesta = '📊 <b>Resumen del mes</b>\\n\\nNo hay gastos confirmados este mes.';\n  } else {\n    const total = filas.reduce((s, r) => s + Number(r.total || 0), 0);\n    const detalle = filas.map(r => `• <b>${esc(r.proyecto)}</b>\\n  <i>${r.compras} ${Number(r.compras) === 1 ? 'compra' : 'compras'}</i> · <b>${money(r.total)}</b>`).join('\\n\\n');\n    respuesta = `📊 <b>Resumen del mes</b>\\n\\n${detalle}\\n\\n<b>Total: ${money(total)}</b>`;\n  }\n} else if (comando === 'ultimos') {\n  const filas = rows.filter(r => r.proyecto);\n  const titulo = esAdmin ? '🧾 <b>Últimos gastos del equipo</b>' : '🧾 <b>Tus últimos gastos</b>';\n  if (!filas.length) {\n    respuesta = `${titulo}\\n\\n${esAdmin ? 'No hay gastos registrados.' : 'No tienes gastos registrados.'}`;\n  } else {\n    const detalle = filas.map(r => {\n      const por = esAdmin && r.registrado_por ? ` · ${esc(r.registrado_por)}` : '';\n      return `• <b>${fecha(r.fecha_gasto)}</b> · ${esc(r.proyecto)}${por}\\n  ${esc(r.proveedor || '(sin proveedor)')} · ${money(r.monto_total)} · ${esc(r.medio_pago || '(sin medio de pago)')}`;\n    }).join('\\n\\n');\n    respuesta = `${titulo}\\n\\n${detalle}`;\n  }\n} else if (comando === 'cancelar') {\n  const n = Number((rows[0] && rows[0].cancelados) || 0);\n  respuesta = n > 0\n    ? `🧹 <b>Registros pendientes</b>\\n\\nListo. Cancelé ${n} ${n === 1 ? 'registro pendiente' : 'registros pendientes'}.`\n    : '🧹 <b>Registros pendientes</b>\\n\\nNo tenías registros pendientes.';\n} else if (comando === 'ayuda') {\n  respuesta = '❓ <b>Ayuda</b>\\n\\n<b>Comandos</b>\\n/proyectos — Obras activas\\n/ultimos — Tus últimos gastos\\n/cancelar — Cancela el registro pendiente\\n/ayuda — Esta ayuda\\n/help y /h también funcionan.\\n\\nTambién puedes usar los botones de abajo.';\n  if (esAdmin) respuesta = respuesta.replace('/proyectos — Obras activas', '/proyectos — Obras activas\\n/resumen — Total del mes\\n/maestras — Administrar proyectos\\n/exportar — Descargar gastos (admin)');\n  if (esAdmin) respuesta = respuesta.replace('/ultimos — Tus últimos gastos', '/ultimos — Últimos gastos del equipo');\n} else {\n  respuesta = `🤔 No reconocí <code>/${esc(comando)}</code>.\\n\\nUsa los botones o escribe /ayuda.`;\n}\n\nreturn [{\n  json: {\n    respuesta,\n    telegram_chat_id: base.telegram_chat_id,\n    telegram_message_id: base.telegram_message_id,\n    usuario_rol: base.usuario_rol || (base.usuario && base.usuario.rol) || null,\n    editar: String(base.callback_data || '').startsWith('cmd:')\n  }\n}];"},"id":