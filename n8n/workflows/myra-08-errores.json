      "parameters": {
        "jsCode": "const e = $json.execution || {};\nconst w = $json.workflow || {};\nconst err = e.error || {};\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst lineas = [\n  '🚨 <b>Error en MYRA</b>',\n  '',\n  `<b>Workflow:</b> ${esc(w.name || '(desconocido)')}`,\n  `<b>Nodo:</b> ${esc(e.lastNodeExecuted || '(desconocido)')}`,\n  `<b>Ejecución:</b> ${esc(e.id || '(no guardada)')}`,\n  `<b>Modo:</b> ${esc(e.mode || '(desconocido)')}`,\n  `<b>Mensaje:</b> ${esc(String(err.message || 'Error desconocido').slice(0, 1200))}`\n];\nif (e.url) lineas.push(`<b>Detalle:</b> <a href=\"${esc(e.url)}\">Abrir ejecución</a>`);\nreturn [{ json: { mensaje: lineas.join('\\n') } }];"
      },
      "type": "n8n-nodes-base.code",
