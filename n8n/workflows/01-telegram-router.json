    {
      "parameters": {
        "jsCode": "const update = $json;\nconst msg = update.message;\nconst cb = update.callback_query;\nconst from = (msg && msg.from) || (cb && cb.from) || {};\nconst chat = (msg && msg.chat) || (cb && cb.message && cb.message.chat) || {};\nconst texto = (msg && msg.text) || '';\nconst esComando = texto.startsWith('/');\n\nlet tipo = 'texto';\nif (cb) tipo = 'callback';\nelse if (msg && msg.voice) tipo = 'voz';\nelse if (msg && msg.photo) tipo = 'foto';\nelse if (esComando) tipo = 'comando';\n\nreturn [{\n  json: {\n    tipo,\n    telegram_chat_id: chat.id,\n    telegram_user_id: from.id,\n    telegram_message_id: (msg && msg.message_id) || (cb && cb.message && cb.message.message_id) || null,\n    texto,\n    comando: esComando ? texto.split(' ')[0].replace('/', '').toLowerCase() : null,\n    callback_data: (cb && cb.data) || null,\n    file_id: (msg && msg.voice && msg.voice.file_id) || null,\n    duracion_seg: (msg && msg.voice && msg.voice.duration) || null,\n    nombre_usuario: [from.first_name, from.last_name].filter(Boolean).join(' '),\n    update_id: update.update_id\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -120,
        0
      ],
      "id": "628274ed-9c06-4bfd-a2ea-c35866f368fe",
      "name": "Normalizar update"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH usuario AS (\n  SELECT id, nombre, rol\n  FROM usuarios\n  WHERE telegram_chat_id = {{ Number($json.telegram_chat_id) }}\n    AND activo\n  LIMIT 1\n)\nSELECT u.id, u.nombre, u.rol\nFROM (SELECT 1) AS dummy\nLEFT JOIN usuario u ON TRUE;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "executeOnce": true,
