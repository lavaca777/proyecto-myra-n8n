    {
      "parameters": {
        "jsCode": "const original = $('Normalizar update').first().json;\nconst usuario = $input.first().json;\nconst autorizado = usuario.id !== null && usuario.id !== undefined;\n\nreturn [{\n  json: {\n    ...original,\n    usuario: {\n      id: usuario.id ?? null,\n      nombre: usuario.nombre ?? null,\n      rol: usuario.rol ?? null\n    },\n    autorizado\n  }\n}];"
      },
