    {
      "parameters": {
        "jsCode": "const tipo = $json.tipo;\nlet respuesta = 'Recibí tu mensaje. Usuario autorizado.';\nif (tipo === 'comando') respuesta = `Comando recibido: /${$json.comando}. Todavía no está implementado.`;\nif (tipo === 'voz') respuesta = 'Recibí tu audio. El procesamiento de voz todavía no está implementado.';\nif (tipo === 'callback') respuesta = `Recibí el botón: ${$json.callback_data || '(sin dato)'}.`;\nif (tipo === 'foto') respuesta = 'Recibí una foto. El OCR todavía no está implementado.';\nreturn [{ json: { ...$json, respuesta } }];"
      },
