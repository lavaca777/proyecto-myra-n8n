    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH cancelados AS (\n  UPDATE registros_entrada\n  SET estado = 'cancelado', campo_pendiente = NULL\n  WHERE usuario_id = $1\n    AND estado IN ('falta_dato', 'pendiente_confirmacion')\n  RETURNING id\n)\nSELECT count(*)::int AS cancelados FROM cancelados;",
        "options": {
          "queryReplacement": "={{ [ $json.usuario_id ] }}"
        }
      },
      "id": "66666666-6666-4666-8666-666666666666",
      "name": "Cancelar",
