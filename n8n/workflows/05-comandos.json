    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT p.id,\n       p.nombre,\n       COALESCE(\n         json_agg(pa.alias ORDER BY pa.alias) FILTER (WHERE pa.alias IS NOT NULL),\n         '[]'::json\n       ) AS alias\nFROM proyectos p\nLEFT JOIN proyecto_alias pa ON pa.proyecto_id = p.id\nWHERE p.activo\nGROUP BY p.id, p.nombre\nORDER BY p.nombre;",
        "options": {}
      },
      "id": "33333333-3333-4333-8333-333333333333",
      "name": "Proyectos",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "executeOnce": true,
      "alwaysOutputData": true,
      "position": [
        448,
        -192
      ],
      "credentials": {
        "postgres": {
          "id": "cTGjz9LhGz7aqgbC",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT proyecto,\n       COUNT(*)::int AS compras,\n       SUM(monto_total)::bigint AS total\nFROM v_gastos_detalle\nWHERE fecha_gasto >= date_trunc('month', current_date)\nGROUP BY proyecto\nORDER BY total DESC;",
        "options": {}
      },
      "id": "44444444-4444-4444-8444-444444444444",
      "name": "Resumen",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "executeOnce": true,
      "alwaysOutputData": true,
      "position": [
        448,
        -32
      ],
      "credentials": {
        "postgres": {
          "id": "cTGjz9LhGz7aqgbC",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT g.fecha_gasto,\n       p.nombre AS proyecto,\n       pr.nombre AS proveedor,\n       g.monto_total,\n       mp.nombre AS medio_pago\nFROM gastos g\nJOIN proyectos p ON p.id = g.proyecto_id\nLEFT JOIN proveedores pr ON pr.id = g.proveedor_id\nLEFT JOIN medios_pago mp ON mp.id = g.medio_pago_id\nWHERE g.usuario_id = $1\nORDER BY g.registrado_en DESC\nLIMIT 5;",
        "options": {
          "queryReplacement": "={{ [ $json.usuario_id ] }}"
        }
      },
      "id": "55555555-5555-4555-8555-555555555555",
      "name": "Ultimos",
      "type": "n8n-nodes-base.postgres",
