    {
      "parameters": {
        "jsCode": "const base = $('Cuando se ejecuta').first().json;\nconst comando = String(base.comando || '').toLowerCase();\nconst nombre = base.usuario_nombre || (base.usuario && base.usuario.nombre) || 'equipo';\nconst rows = $input.all().map(i => i.json).filter(r => r && Object.keys(r).length > 0);\n\nconst esc = (s) => String(s ?? '')\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;');\n\nconst money = (n) => new Intl.NumberFormat('es-CL', {\n  style: 'currency',\n  currency: 'CLP',\n  maximumFractionDigits: 0\n}).format(Number(n) || 0);\n\nconst fecha = (f) => {\n  const s = String(f || '').slice(0, 10);\n  return s ? s.split('-').reverse().join('-') : '(sin fecha)';\n};\n\nconst proyectos = rows.filter(r => r.nombre).map(r => {\n  const alias = Array.isArray(r.alias) ? r.alias : [];\n  const linea = `• <b>${esc(r.nombre)}</b>`;\n  return alias.length\n    ? `${linea}\\n  <i>Alias: ${alias.map(esc).join(', ')}</i>`\n    : linea;\n});\n\nlet respuesta;\nif (comando === 'start') {\n  respuesta = `🏗️ <b>MYRA · Asistente de gastos</b>\\n\\n¡Hola, <b>${esc(nombre)}</b>! Puedo registrar tus compras por voz o texto.\\n\\n<b>Ejemplo</b>\\n<i>“Anota 12.500 en Copec, débito, obra Peñuelas, bencina.”</i>\\n\\n<b>Proyectos disponibles</b>\\n${proyectos.length ? proyectos.join('\\n') : '• (no hay proyectos cargados)'}\\n\\nUsa los botones de abajo o escribe /ayuda.`;\n} else if (comando === 'proyectos') {\n  respuesta = `📁 <b>Proyectos activos</b>\\n\\n${proyectos.length ? proyectos.join('\\n') : '• (no hay proyectos cargados)'}`;\n} else if (comando === 'resumen') {\n  const filas = rows.filter(r => r.proyecto);\n  if (!filas.length) {\n    respuesta = '📊 <b>Resumen del mes</b>\\n\\nNo hay gastos confirmados este mes.';\n  } else {\n    const total = filas.reduce((s, r) => s + Number(r.total || 0), 0);\n    const detalle = filas.map(r => `• <b>${esc(r.proyecto)}</b>\\n  <i>${r.compras} ${Number(r.compras) === 1 ? 'compra' : 'compras'}</i> · <b>${money(r.total)}</b>`).join('\\n\\n');\n    respuesta = `📊 <b>Resumen del mes</b>\\n\\n${detalle}\\n\\n<b>Total: ${money(total)}</b>`;\n  }\n} else if (comando === 'ultimos') {\n  const filas = rows.filter(r => r.proyecto);\n  if (!filas.length) {\n    respuesta = '🧾 <b>Tus últimos gastos</b>\\n\\nNo tienes gastos registrados.';\n  } else {\n    const detalle = filas.map(r => `• <b>${fecha(r.fecha_gasto)}</b> · ${esc(r.proyecto)}\\n  ${esc(r.proveedor || '(sin proveedor)')} · ${money(r.monto_total)} · ${esc(r.medio_pago || '(sin medio de pago)')}`).join('\\n\\n');\n    respuesta = `🧾 <b>Tus últimos gastos</b>\\n\\n${detalle}`;\n  }\n} else if (comando === 'cancelar') {\n  const n = Number((rows[0] && rows[0].cancelados) || 0);\n  respuesta = n > 0\n    ? `🧹 <b>Registros pendientes</b>\\n\\nListo. Cancelé ${n} ${n === 1 ? 'registro pendiente' : 'registros pendientes'}.`\n    : '🧹 <b>Registros pendientes</b>\\n\\nNo tenías registros pendientes.';\n} else if (comando === 'ayuda') {\n  respuesta = '❓ <b>Ayuda</b>\\n\\n<b>Comandos</b>\\n/proyectos — Obras activas\\n/resumen — Total del mes\\n/ultimos — Tus últimos gastos\\n/cancelar — Cancela el registro pendiente\\n/ayuda — Esta ayuda\\n/help y /h también funcionan.\\n\\nTambién puedes usar los botones de abajo.';\n} else {\n  respuesta = `🤔 No reconocí <code>/${esc(comando)}</code>.\\n\\nUsa los botones o escribe /ayuda.`;\n}\n\nreturn [{\n  json: {\n    respuesta,\n    telegram_chat_id: base.telegram_chat_id,\n    telegram_message_id: base.telegram_message_id,\n    editar: String(base.callback_data || '').startsWith('cmd:')\n  }\n}];"
      },
