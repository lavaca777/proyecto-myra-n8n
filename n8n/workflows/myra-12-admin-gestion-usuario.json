    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH limpiar AS (\n  DELETE FROM usuarios\n  WHERE telegram_chat_id IS NULL\n    AND activo = false\n    AND codigo_vinculacion IS NOT NULL\n    AND COALESCE(codigo_expira_at, creado_en + INTERVAL '24 hours') < now()\n  RETURNING id\n)\nSELECT id, nombre, rol, activo, telegram_chat_id, codigo_vinculacion\nFROM usuarios\nWHERE id NOT IN (SELECT id FROM limpiar)\nORDER BY activo DESC, id ASC\nLIMIT 30;",
        "options": {}
      },
      "id": "d007ac33-18f4-43b0-a7fa-4271ee791f1f",
      "name": "Consultar usuarios",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -240,
        32
