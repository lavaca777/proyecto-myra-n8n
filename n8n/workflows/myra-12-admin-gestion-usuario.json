    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r.id);\nconst chatId = $('Clasificar accion').first().json.chat_id;\n\nconst inline_keyboard = rows.map(u => {\n  const icono = u.activo ? '🟢' : (u.codigo_vinculacion ? '🟡' : '🔴');\n  return [{\n    text: `${icono} ${u.nombre} (${u.rol})`,\n    callback_data: `usr_ver:${u.id}`\n  }];\n});\n\ninline_keyboard.push([{\n  text: '➕ Invitar nuevo usuario',\n  callback_data: 'admin_invitar'\n}]);\n\nconst texto = `👥 *Gestión de Usuarios (${rows.length})*\\n\\n🟢 Activo  |  🟡 Invitación pendiente  |  🔴 Revocado\\n\\nSelecciona un usuario para editar su rol o acceso:`;\n\nreturn [{\n  json: {\n    chat_id: chatId,\n    text: texto,\n    parse_mode: 'Markdown',\n    reply_markup: { inline_keyboard }\n  }\n}];"
      },
