    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r.id);\nconst chatId = $('Clasificar accion').first().json.chat_id;\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nconst lineas = rows.map(u => {\n  const icono = u.activo ? '🟢' : (u.codigo_vinculacion ? '🟡' : '🔴');\n  return `${icono} <b>${esc(u.nombre)}</b> (${esc(u.rol)}) — /usr${u.id}`;\n});\n\nconst listaTexto = lineas.length > 0 ? lineas.join('\\n') : '<i>No hay usuarios registrados.</i>';\n\nconst texto = `👥 <b>Gestión de Usuarios (${rows.length})</b>\\n\\n🟢 Activo  |  🟡 Pendiente  |  🔴 Revocado\\n\\n${listaTexto}\\n\\n👆 Toca el comando azul /usrID de un usuario para gestionarlo:`;\n\nreturn [{\n  json: {\n    chat_id: chatId,\n    text: texto\n  }\n}];"
      },
