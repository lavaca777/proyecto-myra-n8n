      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        -1008,
        432
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst usuario = input.usuario || {};\nconst chatId = input.telegram_chat_id || usuario.telegram_chat_id;\nconst texto = (input.texto || '').trim();\nconst cb = (input.callback_data || '').trim();\n\nlet accion = 'unknown';\nlet targetId = null;\nlet nuevoRol = null;\n\nif (usuario.rol !== 'administrador') {\n  accion = 'denegado';\n} else if (cb === 'admin_usuarios' || texto === '/usuarios') {\n  accion = 'listar';\n} else if (cb.startsWith('usr_ver:') || /^\\/usr_?\\d+$/.test(texto)) {\n  accion = 'ver';\n  targetId = cb.startsWith('usr_ver:')\n    ? parseInt(cb.split(':')[1], 10)\n    : parseInt(texto.replace(/^\\/usr_?/, ''), 10);\n} else if (cb.startsWith('usr_rol_menu:')) {\n  accion = 'rol_menu';\n  targetId = parseInt(cb.split(':')[1], 10);\n} else if (cb.startsWith('usr_set_rol:')) {\n  accion = 'set_rol';\n  const parts = cb.split(':');\n  targetId = parseInt(parts[1], 10);\n  nuevoRol = parts[2];\n} else if (cb.startsWith('usr_revocar:')) {\n  accion = 'revocar';\n  targetId = parseInt(cb.split(':')[1], 10);\n} else if (cb.startsWith('usr_reinvitar:')) {\n  accion = 'reinvitar';\n  targetId = parseInt(cb.split(':')[1], 10);\n} else if (cb.startsWith('usr_del_confirm:')) {\n  accion = 'del_confirm';\n  targetId = parseInt(cb.split(':')[1], 10);\n} else if (cb.startsWith('usr_del_exec:')) {\n  accion = 'del_exec';\n  targetId = parseInt(cb.split(':')[1], 10);\n}\n\nconst esMismoUsuario = targetId !== null && Number(targetId) === Number(usuario.id);\n\nreturn [{\n  json: {\n    chat_id: chatId,\n    admin_id: usuario.id,\n    accion,\n    target_id: targetId,\n    nuevo_rol: nuevoRol,\n    es_mismo_usuario: esMismoUsuario\n  }\n}];"
      },
