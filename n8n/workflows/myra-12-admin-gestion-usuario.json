      "parameters": {
        "jsCode": "const u = $input.first().json;\nconst ctx = $('Clasificar accion').first().json;\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nif (!u || !u.id) {\n  return [{\n    json: {\n      chat_id: ctx.chat_id,\n      encontrado: false,\n      text: '⚠️ Usuario no encontrado.'\n    }\n  }];\n}\n\nconst estado = u.activo\n  ? '🟢 Activo'\n  : (u.codigo_vinculacion ? `🟡 Pendiente (Código: <code>${esc(u.codigo_vinculacion)}</code>)` : '🔴 Acceso revocado');\n\nreturn [{\n  json: {\n    chat_id: ctx.chat_id,\n    encontrado: true,\n    user_id: u.id,\n    activo: Boolean(u.activo),\n    text: `👤 <b>Ficha de Usuario</b>\\n\\n• <b>ID:</b> ${u.id}\\n• <b>Nombre:</b> ${esc(u.nombre)}\\n• <b>Rol:</b> ${esc(u.rol)}\\n• <b>Estado:</b> ${estado}`\n  }\n}];"
      },
