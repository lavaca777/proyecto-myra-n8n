    {
      "parameters": {
        "jsCode": "const ctx = $input.first().json;\nconst chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';\nlet rand = '';\nfor (let i = 0; i < 5; i++) rand += chars.charAt(Math.floor(Math.random() * chars.length));\nreturn [{ json: { ...ctx, codigo: `MYRA-${rand}` } }];"
