    {
      "parameters": {
        "jsCode": "const u = $input.first().json;\nconst ctx = $('Clasificar accion').first().json;\nconst estado = u.activo ? '🟢 Activo' : (u.codigo_vinculacion ? `🟡 Pendiente (Código: \\`${u.codigo_vinculacion}\\`)` : '🔴 Acceso revocado');\n\nconst keyboard = [\n  [{ text: '🔄 Cambiar rol', callback_data: `usr_rol_menu:${u.id}` }]\n];\n\nif (u.activo) {\n  keyboard.push([{ text: '🔴 Revocar acceso', callback_data: `usr_revocar:${u.id}` }]);\n} else {\n  keyboard.push([\n    { text: '🟢 Re-invitar (nuevo código)', callback_data: `usr_reinvitar:${u.id}` },\n    { text: '🗑️ Eliminar', callback_data: `usr_del_confirm:${u.id}` }\n  ]);\n}\n\nkeyboard.push([{ text: '⬅️ Volver a la lista', callback_data: 'admin_usuarios' }]);\n\nreturn [{\n  json: {\n    chat_id: ctx.chat_id,\n    text: `👤 *Ficha de Usuario*\\n\\n• *ID:* ${u.id}\\n• *Nombre:* ${u.nombre}\\n• *Rol:* ${u.rol}\\n• *Estado:* ${estado}`,\n    parse_mode: 'Markdown',\n    reply_markup: { inline_keyboard: keyboard }\n  }\n}];"
      },
