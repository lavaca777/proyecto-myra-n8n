    {
      "parameters": {
        "jsCode": "const ctx = $input.first().json;\nif (ctx.es_mismo_usuario) {\n  return [{\n    json: {\n      chat_id: ctx.chat_id,\n      text: '⚠️ Por seguridad, no puedes modificar tu propio rol de administrador.',\n      reply_markup: { inline_keyboard: [[{ text: '⬅️ Volver', callback_data: `usr_ver:${ctx.target_id}` }]] }\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    chat_id: ctx.chat_id,\n    text: '🔄 Selecciona el *nuevo rol* para este usuario:',\n    parse_mode: 'Markdown',\n    reply_markup: {\n      inline_keyboard: [\n        [{ text: '👷 Jefe de Obra', callback_data: `usr_set_rol:${ctx.target_id}:jefe_obra` }],\n        [\n          { text: '📊 Gerencia', callback_data: `usr_set_rol:${ctx.target_id}:gerencia` },\n          { text: '🛡️ Administrador', callback_data: `usr_set_rol:${ctx.target_id}:administrador` }\n        ],\n        [{ text: '⬅️ Cancelar', callback_data: `usr_ver:${ctx.target_id}` }]\n      ]\n    }\n  }\n}];"
      },
