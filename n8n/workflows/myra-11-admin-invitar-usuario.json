    {
      "parameters": {
        "jsCode": "const i = $input.first().json;\nconst usuario = i.usuario || {};\nconst texto = String(i.texto || '').trim();\nconst cb = String(i.callback_data || '');\nconst alfabeto = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';\nlet sufijo = '';\nfor (let n = 0; n < 5; n++) sufijo += alfabeto[Math.floor(Math.random() * alfabeto.length)];\n\nlet ruta = 'ignorar';\nif (usuario.rol !== 'administrador') ruta = 'sin_permiso';\nelse if (cb === 'admin_invitar' || texto === '/invitar') ruta = 'generar';\n\nreturn [{ json: { telegram_chat_id: i.telegram_chat_id, texto, callback_data: cb, usuario, usuario_id: usuario.id ?? null, ruta, rol_sel: 'jefe_obra', codigo: 'MYRA-' + sufijo } }];"
      },
      "id": "7f54716c-1848-4c89-a5be-3784b8214a68",
      "name": "Clasificar",
      "type": "n8n-nodes-base.code",
