        "operation": "executeQuery",
        "query": "WITH pend AS (\n  DELETE FROM admin_pending\n  WHERE usuario_id = $1\n    AND accion = 'invitar_rol'\n  RETURNING datos->>'nombre' AS nombre\n)\nINSERT INTO usuarios (nombre, rol, activo, codigo_vinculacion, codigo_expira_at)\nSELECT nombre, $2::text, false, $3::text, NOW() + INTERVAL '24 hours'\nFROM pend\nRETURNING nombre, rol, codigo_vinculacion;",
