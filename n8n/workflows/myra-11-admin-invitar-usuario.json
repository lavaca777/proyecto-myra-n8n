    {
      "parameters": {
        "jsCode": "const i = $input.first().json;\nconst usuario = i.usuario || {};\nconst texto = String(i.texto || '').trim();\nconst cb = String(i.callback_data || '');\nconst roles = ['jefe_obra', 'gerencia', 'administrador'];\nconst alfabeto = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';\nlet sufijo = '';\nfor (let n = 0; n < 5; n++) sufijo += alfabeto[Math.floor(Math.random() * alfabeto.length)];\nconst rolSel = cb.startsWith('inv_rol:') ? cb.slice(8) : '';\n\nlet ruta = 'ignorar';\nif (usuario.rol !== 'administrador') ruta = 'sin_permiso';\nelse if (texto === '/cancelar') ruta = 'cancelar';\nelse if (cb === 'admin_invitar' || texto === '/invitar') ruta = 'inicio';\nelse if (cb.startsWith('inv_rol:') && roles.includes(rolSel)) ruta = 'generar';\nelse if (!cb && texto && !texto.startsWith('/')) ruta = 'nombre';\n\nreturn [{ json: { telegram_chat_id: i.telegram_chat_id, texto, callback_data: cb, usuario, usuario_id: usuario.id ?? null, ruta, rol_sel: rolSel, codigo: 'MYRA-' + sufijo } }];"
      },
      "id": "7f54716c-1848-4c89-a5be-3784b8214a68",
      "name": "Clasificar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -640,
        576
      ]
    },
    {
      "parameters": {
        "mode": "expression",
        "numberOutputs": 6,
        "output": "={{ ['sin_permiso','cancelar','inicio','nombre','generar'].indexOf($json.ruta) >= 0 ? ['sin_permiso','cancelar','inicio','nombre','generar'].indexOf($json.ruta) : 5 }}"
      },
