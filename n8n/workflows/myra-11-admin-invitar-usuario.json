        "query": "INSERT INTO admin_pending (usuario_id, accion, paso, datos, payload)\nVALUES ($1, 'invitar_nombre', 'esperando', '{}'::jsonb, '{}'::jsonb)\nON CONFLICT (usuario_id) DO UPDATE\nSET accion = 'invitar_nombre', paso = 'esperando', entidad_id = NULL,\n    datos = '{}'::jsonb, payload = '{}'::jsonb, actualizado_en = now()\nRETURNING id;",
