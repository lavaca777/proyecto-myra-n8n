# =====================================================================
# Plantilla de variables de entorno
# Copiar a .env y completar los valores.
#   Windows:  Copy-Item .env.example .env
# =====================================================================

# --- PostgreSQL (datos del negocio) ---
DB_USER=myra
DB_PASSWORD=cambia_esta_clave
DB_NAME=myra

# --- n8n ---
# Cadena aleatoria larga (32+ caracteres). Ejemplo para generarla:
#   [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# Si ya tienes una instancia con credenciales, usa la MISMA clave que tenias.
N8N_ENCRYPTION_KEY=cambia_esta_clave_por_una_aleatoria

# URL publica para webhooks de Telegram.
# Local: http://localhost:5678/
# Con tunel: scripts/tunnel.ps1 la actualiza sola.
WEBHOOK_URL=http://localhost:5678/
