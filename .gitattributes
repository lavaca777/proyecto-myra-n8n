# =====================================================================
# Normalizacion de saltos de linea.
# Los scripts .sh DEBEN tener LF para poder ejecutarse en Linux.
# =====================================================================
* text=auto

*.sh    text eol=lf
*.sql   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.conf  text eol=lf
*.service text eol=lf
Caddyfile text eol=lf
.gitignore text eol=lf
.env.example text eol=lf
.env.production.example text eol=lf

# PowerShell tolera LF, pero CRLF es lo habitual en Windows.
*.ps1   text eol=crlf
